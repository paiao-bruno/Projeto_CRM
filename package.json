{
  "name": "isp-crm-saas",
  "version": "1.0.0",
  "description": "CRM SaaS multitenant para provedores de internet",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/ensure-db.mjs && npm run prisma:generate && npm run db:push && node scripts/dev.mjs",
    "dev:no-db": "node scripts/dev.mjs",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:format": "prisma format --schema prisma/schema.prisma"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paiao-bruno/Projeto_CRM.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/paiao-bruno/Projeto_CRM/issues"
  },
  "homepage": "https://github.com/paiao-bruno/Projeto_CRM#readme",
  "devDependencies": {
    "prisma": "^7.8.0"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  },
  "private": true,
  "type": "module"
}
