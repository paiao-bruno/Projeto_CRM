{
  "name": "isp-crm-saas",
  "version": "1.0.0",
  "description": "CRM SaaS multitenant para provedores de internet",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "dev": "node scripts/dev-site.mjs",
    "dev:web": "node scripts/dev-site.mjs",
    "dev:web:funnel": "node scripts/dev-site.mjs",
    "dev:web:funnel:ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-web-funnel.ps1",
    "dev:funnel": "node scripts/dev-funnel.mjs",
    "dev:no-db": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "npm run test -w apps/web && npm run test:unified-site",
    "audit": "npm audit --workspaces",
    "typecheck": "npm run typecheck -w apps/web",
    "lint": "npm run typecheck",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "db:migrate:reset": "prisma migrate reset --schema prisma/schema.prisma --force",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:validate:migrations": "node scripts/validate-prisma.mjs",
    "prisma:format": "prisma format --schema prisma/schema.prisma",
    "homologate:sgp": "node scripts/homologate-sgp-real.mjs",
    "investigate:sgp": "node scripts/investigate-sgp-sync.mjs",
    "audit:sgp-regression": "node scripts/audit-sgp-regression.mjs",
    "bootstrap:web-only": "node scripts/bootstrap-web-only.mjs",
    "ensure:sales-funnel-permissions": "node scripts/ensure-sales-funnel-permissions.mjs",
    "test:disposable-db": "node --test scripts/disposable-db.spec.mjs",
    "test:jwt-secret": "node --test scripts/jwt-secret.spec.mjs",
    "test:sales-funnel-contract": "node scripts/sales-funnel-contract.spec.mjs",
    "test:unified-site": "node --test scripts/unified-site.spec.mjs",
    "test:bootstrap-permissions": "node --test scripts/bootstrap-permissions.spec.mjs",
    "test:bootstrap": "node --test scripts/bootstrap-production.spec.mjs",
    "reencrypt:sgp-integration": "node scripts/reencrypt-sgp-integration.mjs",
    "reencrypt:sgp-integration:preflight": "node scripts/reencrypt-sgp-integration.mjs --preflight",
    "test:reencrypt-sgp-integration": "npm run build -w apps/api && node --test scripts/reencrypt-sgp-integration.spec.mjs",
    "test:reencrypt-sgp-integration:live": "npm run build -w apps/api && node scripts/reencrypt-sgp-integration.integration.mjs",
    "load-test": "node scripts/load-test.mjs",
    "db:test-migrate-deploy": "node scripts/test-migrate-deploy.mjs",
    "test:sales-funnel-integration": "node scripts/test-sales-funnel-integration.mjs",
    "test:inbox-integration": "node scripts/test-inbox-integration.mjs",
    "prisma:validate:static": "node scripts/validate-prisma.mjs --static-only",
    "test:harness": "node --test scripts/test-harness.spec.mjs",
    "test:records-integration": "node scripts/test-inbox-integration.mjs src/server/records.integration.ts",
    "test:outbox-integration": "node scripts/test-inbox-integration.mjs src/server/outbox/outbox.integration.ts",
    "dev:legacy-api": "node scripts/dev.mjs",
    "worker": "node scripts/outbox-worker.mjs",
    "build:legacy-api": "npm run build -w apps/api",
    "start": "npm run start -w apps/web",
    "test:legacy-api": "npm run test -w apps/api",
    "typecheck:legacy-api": "npm run typecheck -w apps/api",
    "test:all-local": "npm run test && npm run test:harness && npm run prisma:validate:migrations && npm run test:sales-funnel-integration && npm run test:inbox-integration && npm run test:records-integration && npm run test:outbox-integration && npm run test:site-e2e",
    "test:site-e2e": "node scripts/test-site-e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paiao-bruno/Projeto_CRM.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/paiao-bruno/Projeto_CRM/issues"
  },
  "homepage": "https://github.com/paiao-bruno/Projeto_CRM#readme",
  "devDependencies": {
    "prisma": "^7.8.0"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.2.0"
    }
  }
}
