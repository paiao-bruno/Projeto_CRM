generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto, vector]
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum MemberStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum RoleScope {
  SYSTEM
  TENANT
}

enum IntegrationProvider {
  WHATSAPP
  WEBHOOK
  EXTERNAL_API
  SGP
  OPENAI
  ANTHROPIC
  GOOGLE
  STORAGE
  EMAIL
}

enum IntegrationStatus {
  DRAFT
  CONNECTING
  ACTIVE
  DEGRADED
  DISCONNECTED
  ERROR
  DISABLED
}

enum HealthStatus {
  UNKNOWN
  HEALTHY
  WARNING
  DOWN
}

enum ConversationStatus {
  OPEN
  PENDING
  SOLVED
  ARCHIVED
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum MessageSenderType {
  CUSTOMER
  USER
  AI_AGENT
  SYSTEM
}

enum MessageContentType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEMPLATE
  SYSTEM
}

enum HandoffTarget {
  USER
  AI_AGENT
  QUEUE
}

enum HandoffStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  CANCELED
  COMPLETED
}

enum FileAssetStatus {
  UPLOADING
  READY
  FAILED
  DELETED
}

enum TeamRoomType {
  DIRECT
  GROUP
  OPERATIONS
}

enum AiProvider {
  OPENAI
  CLAUDE
  GEMINI
}

enum AiAgentStatus {
  ACTIVE
  INACTIVE
  TRAINING
  ERROR
}

enum KnowledgeBaseStatus {
  ACTIVE
  ARCHIVED
}

enum KnowledgeDocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum KnowledgeSourceType {
  DOCUMENT
  URL
  MANUAL_TEXT
  FAQ
}

enum FaqStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FlowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum FlowNodeType {
  TRIGGER
  CONDITION
  MESSAGE
  AI_AGENT
  WEBHOOK
  ASSIGNMENT
  DELAY
  END
}

enum FlowExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  OVERDUE
  CHURNED
  PROSPECT
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  WON
  LOST
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ContractStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CANCELED
  UNKNOWN
}

enum InvoiceStatus {
  OPEN
  PAID
  OVERDUE
  CANCELED
  UNKNOWN
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELED
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  CONVERTED
}

enum ScheduleEventStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELED
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum MetricGranularity {
  MINUTE
  HOUR
  DAY
}

enum AgentMemoryLevel {
  BEGINNER
  LEARNING
  DEVELOPING
  EXPERIENCED
  MASTER
}

enum MemorySource {
  DOCUMENT_PROCESSED
  TRAINING_COMPLETED
  CONVERSATION_USEFUL
  KNOWLEDGE_ADDED
  FAQ_CREATED
  INTEGRATION_SYNC
}

enum IntegrationSyncStatus {
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
  SKIPPED
}

enum IntegrationSyncEntity {
  CUSTOMER
  CONTRACT
  INVOICE
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  document  String?
  status    TenantStatus @default(TRIAL)
  settings  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  members             TenantMember[]
  roles               Role[]
  integrations        Integration[]
  webhookEndpoints    WebhookEndpoint[]
  apiKeys             ApiKey[]
  fileAssets          FileAsset[]
  conversations       Conversation[]
  messages            Message[]
  handoffs            ConversationHandoff[]
  teamRooms           TeamRoom[]
  teamMessages        TeamMessage[]
  teamPresence        TeamPresence[]
  aiAgents            AiAgent[]
  agentMemories       AgentMemory[]
  memoryHistory       MemoryHistory[]
  agentKnowledge      AiAgentKnowledgeBase[]
  knowledgeBases      KnowledgeBase[]
  documents           KnowledgeDocument[]
  knowledgeChunks     KnowledgeChunk[]
  faqItems            FaqItem[]
  flows               Flow[]
  flowVersions        FlowVersion[]
  flowNodes           FlowNode[]
  flowEdges           FlowEdge[]
  flowExecutions      FlowExecution[]
  flowSteps           FlowExecutionStep[]
  customers           Customer[]
  contracts           Contract[]
  invoices            Invoice[]
  integrationSyncRuns IntegrationSyncRun[]
  integrationSyncLogs IntegrationSyncLog[]
  contacts            CustomerContact[]
  activities          ContactActivity[]
  leads               Lead[]
  pipelines           Pipeline[]
  pipelineStages      PipelineStage[]
  deals               Deal[]
  campaigns           Campaign[]
  campaignRecipients  CampaignRecipient[]
  campaignEvents      CampaignEvent[]
  scheduleEvents      ScheduleEvent[]
  tasks               Task[]
  dashboardMetrics    DashboardMetric[]
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@index([status])
}

model IntegrationSyncRun {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @db.Uuid
  integrationId String?               @db.Uuid
  triggeredById String?               @db.Uuid
  operation     String
  status        IntegrationSyncStatus @default(RUNNING)
  syncMode      String?
  trigger       String?
  startedAt     DateTime              @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  processed     Int                   @default(0)
  created       Int                   @default(0)
  updated       Int                   @default(0)
  ignored       Int                   @default(0)
  errorsCount   Int                   @default(0)
  customersProcessed Int              @default(0)
  customersCreated   Int              @default(0)
  customersUpdated   Int              @default(0)
  customersDeleted   Int              @default(0)
  customersIgnored   Int              @default(0)
  contractsProcessed Int              @default(0)
  contractsCreated   Int              @default(0)
  contractsUpdated   Int              @default(0)
  contractsDeleted   Int              @default(0)
  contractsIgnored   Int              @default(0)
  invoicesProcessed  Int              @default(0)
  invoicesCreated    Int              @default(0)
  invoicesUpdated    Int              @default(0)
  invoicesDeleted    Int              @default(0)
  invoicesIgnored    Int              @default(0)
  errors        Json?
  stackTrace    String?               @db.Text
  cursor        Json?
  errorMessage  String?
  metadata      Json?

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration Integration?         @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  triggeredBy TenantMember?        @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  logs        IntegrationSyncLog[]

  @@index([tenantId, status, startedAt])
  @@index([tenantId, operation, startedAt])
  @@index([tenantId, operation, status, finishedAt])
  @@index([tenantId, integrationId, startedAt])
  @@index([operation, status, startedAt])
}

model IntegrationSyncLog {
  id         String                @id @default(uuid()) @db.Uuid
  tenantId   String                @db.Uuid
  runId      String                @db.Uuid
  entity     IntegrationSyncEntity
  externalId String?
  action     String
  status     IntegrationSyncStatus
  message    String?
  metadata   Json?
  createdAt  DateTime              @default(now())

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    IntegrationSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([tenantId, runId, createdAt])
  @@index([tenantId, entity, externalId])
  @@index([tenantId, status, createdAt])
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  passwordHash String
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships TenantMember[]
  sessions    AuthSession[]
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  currentTenantId  String?   @db.Uuid
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TenantMember {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  userId      String       @db.Uuid
  roleId      String?      @db.Uuid
  displayName String?
  jobTitle    String?
  status      MemberStatus @default(INVITED)
  lastSeenAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                  Role?                 @relation(fields: [roleId], references: [id], onDelete: SetNull)
  assignedConversations Conversation[]        @relation("AssignedConversations")
  sentMessages          Message[]             @relation("MemberMessages")
  requestedHandoffs     ConversationHandoff[] @relation("RequestedHandoffs")
  fromMemberHandoffs    ConversationHandoff[] @relation("FromMemberHandoffs")
  toMemberHandoffs      ConversationHandoff[] @relation("ToMemberHandoffs")
  roomMemberships       TeamRoomMember[]
  teamMessages          TeamMessage[]
  presence              TeamPresence?
  ownedCustomers        Customer[]            @relation("CustomerOwner")
  ownedLeads            Lead[]                @relation("LeadOwner")
  ownedDeals            Deal[]                @relation("DealOwner")
  assignedEvents        ScheduleEvent[]       @relation("EventAssignee")
  assignedTasks         Task[]                @relation("TaskAssignee")
  integrationSyncRuns   IntegrationSyncRun[]
  uploadedFiles         FileAsset[]           @relation("FileUploader")
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([roleId])
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String
  description String?
  scope       RoleScope @default(TENANT)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     TenantMember[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Integration {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  provider         IntegrationProvider
  name             String
  status           IntegrationStatus   @default(DRAFT)
  healthStatus     HealthStatus        @default(UNKNOWN)
  config           Json?
  encryptedSecrets String?
  lastConnectedAt  DateTime?
  lastError        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookEndpoints WebhookEndpoint[]
  conversations    Conversation[]
  campaigns        Campaign[]
  syncRuns         IntegrationSyncRun[]

  @@unique([tenantId, provider, name])
  @@index([tenantId, status])
  @@index([tenantId, healthStatus])
  @@index([provider, status])
}

model WebhookEndpoint {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  integrationId String?  @db.Uuid
  name          String
  url           String
  secretHash    String?
  isActive      Boolean  @default(true)
  headers       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([tenantId, isActive])
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  name       String
  keyHash    String
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model FileAsset {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @db.Uuid
  uploadedByMemberId String?         @db.Uuid
  storageKey         String
  publicUrl          String?
  filename           String
  mimeType           String
  byteSize           BigInt
  checksum           String?
  status             FileAssetStatus @default(READY)
  metadata           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy TenantMember?       @relation("FileUploader", fields: [uploadedByMemberId], references: [id], onDelete: SetNull)
  messages   Message[]
  documents  KnowledgeDocument[]

  @@unique([tenantId, storageKey])
  @@index([tenantId, status])
}

model Conversation {
  id                   String               @id @default(uuid()) @db.Uuid
  tenantId             String               @db.Uuid
  customerId           String?              @db.Uuid
  channelIntegrationId String?              @db.Uuid
  assignedMemberId     String?              @db.Uuid
  activeAiAgentId      String?              @db.Uuid
  externalId           String?
  subject              String?
  status               ConversationStatus   @default(OPEN)
  priority             ConversationPriority @default(NORMAL)
  lastMessageAt        DateTime?
  closedAt             DateTime?
  metadata             Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  channelIntegration Integration?          @relation(fields: [channelIntegrationId], references: [id], onDelete: SetNull)
  assignedMember     TenantMember?         @relation("AssignedConversations", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  activeAiAgent      AiAgent?              @relation("ActiveAiAgentConversations", fields: [activeAiAgentId], references: [id], onDelete: SetNull)
  messages           Message[]
  handoffs           ConversationHandoff[]
  activities         ContactActivity[]
  flowExecutions     FlowExecution[]
  scheduleEvents     ScheduleEvent[]
  tasks              Task[]

  @@unique([tenantId, externalId])
  @@index([tenantId, status, lastMessageAt])
  @@index([tenantId, assignedMemberId])
  @@index([tenantId, customerId])
  @@index([tenantId, activeAiAgentId, status])
}

model Message {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @db.Uuid
  conversationId   String             @db.Uuid
  senderType       MessageSenderType
  direction        MessageDirection
  contentType      MessageContentType @default(TEXT)
  body             String?
  externalId       String?
  senderMemberId   String?            @db.Uuid
  senderCustomerId String?            @db.Uuid
  senderAiAgentId  String?            @db.Uuid
  fileAssetId      String?            @db.Uuid
  metadata         Json?
  sentAt           DateTime?
  deliveredAt      DateTime?
  readAt           DateTime?
  createdAt        DateTime           @default(now())

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderMember   TenantMember? @relation("MemberMessages", fields: [senderMemberId], references: [id], onDelete: SetNull)
  senderCustomer Customer?     @relation("CustomerMessages", fields: [senderCustomerId], references: [id], onDelete: SetNull)
  senderAiAgent  AiAgent?      @relation("AiAgentMessages", fields: [senderAiAgentId], references: [id], onDelete: SetNull)
  fileAsset      FileAsset?    @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@unique([tenantId, externalId])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, senderType])
  @@index([tenantId, createdAt])
  @@index([tenantId, senderAiAgentId])
  @@index([tenantId, senderType, createdAt])
}

model ConversationHandoff {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @db.Uuid
  conversationId      String        @db.Uuid
  requestedByMemberId String?       @db.Uuid
  fromMemberId        String?       @db.Uuid
  toMemberId          String?       @db.Uuid
  fromAiAgentId       String?       @db.Uuid
  toAiAgentId         String?       @db.Uuid
  target              HandoffTarget
  status              HandoffStatus @default(REQUESTED)
  reason              String?
  createdAt           DateTime      @default(now())
  resolvedAt          DateTime?

  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation      Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestedByMember TenantMember? @relation("RequestedHandoffs", fields: [requestedByMemberId], references: [id], onDelete: SetNull)
  fromMember        TenantMember? @relation("FromMemberHandoffs", fields: [fromMemberId], references: [id], onDelete: SetNull)
  toMember          TenantMember? @relation("ToMemberHandoffs", fields: [toMemberId], references: [id], onDelete: SetNull)
  fromAiAgent       AiAgent?      @relation("FromAiAgentHandoffs", fields: [fromAiAgentId], references: [id], onDelete: SetNull)
  toAiAgent         AiAgent?      @relation("ToAiAgentHandoffs", fields: [toAiAgentId], references: [id], onDelete: SetNull)

  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, status])
}

model TeamRoom {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  name      String?
  type      TeamRoomType @default(GROUP)
  directKey String?
  metadata  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members  TeamRoomMember[]
  messages TeamMessage[]

  @@unique([tenantId, directKey])
  @@index([tenantId, type])
}

model TeamRoomMember {
  roomId   String    @db.Uuid
  memberId String    @db.Uuid
  joinedAt DateTime  @default(now())
  mutedAt  DateTime?

  room   TeamRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  member TenantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([roomId, memberId])
  @@index([memberId])
}

model TeamMessage {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  roomId    String    @db.Uuid
  memberId  String    @db.Uuid
  body      String
  metadata  Json?
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room   TeamRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  member TenantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, roomId, createdAt])
}

model TeamPresence {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  memberId   String    @unique @db.Uuid
  isOnline   Boolean   @default(false)
  status     String?
  socketId   String?
  lastSeenAt DateTime?
  updatedAt  DateTime  @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member TenantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, isOnline])
}

model AiAgent {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  name         String
  description  String?
  provider     AiProvider
  model        String
  systemPrompt String
  temperature  Decimal?      @db.Decimal(3, 2)
  maxTokens    Int?
  status       AiAgentStatus @default(INACTIVE)
  isDefault    Boolean       @default(false)
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  knowledgeBases      AiAgentKnowledgeBase[]
  activeConversations Conversation[]         @relation("ActiveAiAgentConversations")
  sentMessages        Message[]              @relation("AiAgentMessages")
  fromHandoffs        ConversationHandoff[]  @relation("FromAiAgentHandoffs")
  toHandoffs          ConversationHandoff[]  @relation("ToAiAgentHandoffs")
  flowNodes           FlowNode[]
  memory              AgentMemory?
  memoryHistory       MemoryHistory[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model AgentMemory {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  agentId            String           @unique @map("agent_id") @db.Uuid
  learnedMemories    Int              @default(0) @map("learned_memories")
  totalMemories      Int              @default(100) @map("total_memories")
  learningPercentage Int              @default(0) @map("learning_percentage")
  level              AgentMemoryLevel @default(BEGINNER)
  lastUpdate         DateTime         @default(now()) @map("last_update")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId, level])
  @@index([tenantId, learningPercentage])
  @@map("agent_memory")
}

model MemoryHistory {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  agentId       String       @map("agent_id") @db.Uuid
  memoriesAdded Int          @map("memories_added")
  source        MemorySource
  createdAt     DateTime     @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId, agentId, createdAt])
  @@index([tenantId, source, createdAt])
  @@map("memory_history")
}

model AiAgentKnowledgeBase {
  tenantId        String   @db.Uuid
  aiAgentId       String   @db.Uuid
  knowledgeBaseId String   @db.Uuid
  createdAt       DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  aiAgent       AiAgent       @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@id([aiAgentId, knowledgeBaseId])
  @@index([tenantId])
}

model KnowledgeBase {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  name        String
  slug        String
  description String?
  status      KnowledgeBaseStatus @default(ACTIVE)
  metadata    Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agents    AiAgentKnowledgeBase[]
  documents KnowledgeDocument[]
  chunks    KnowledgeChunk[]
  faqItems  FaqItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model KnowledgeDocument {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @db.Uuid
  knowledgeBaseId String                  @db.Uuid
  fileAssetId     String?                 @db.Uuid
  title           String
  sourceType      KnowledgeSourceType
  sourceUrl       String?
  rawText         String?
  status          KnowledgeDocumentStatus @default(PENDING)
  errorMessage    String?
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  fileAsset     FileAsset?       @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  chunks        KnowledgeChunk[]

  @@index([tenantId, knowledgeBaseId, status])
}

model KnowledgeChunk {
  id              String                       @id @default(uuid()) @db.Uuid
  tenantId        String                       @db.Uuid
  knowledgeBaseId String                       @db.Uuid
  documentId      String?                      @db.Uuid
  content         String
  tokenCount      Int?
  embedding       Unsupported("vector(1536)")?
  metadata        Json?
  createdAt       DateTime                     @default(now())

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase      @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  document      KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, knowledgeBaseId])
}

model FaqItem {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  knowledgeBaseId String    @db.Uuid
  question        String
  answer          String
  status          FaqStatus @default(DRAFT)
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([tenantId, knowledgeBaseId, status])
}

model Flow {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @db.Uuid
  name            String
  description     String?
  status          FlowStatus @default(DRAFT)
  activeVersionId String?    @db.Uuid
  metadata        Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions   FlowVersion[]
  executions FlowExecution[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model FlowVersion {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @db.Uuid
  flowId      String     @db.Uuid
  version     Int
  status      FlowStatus @default(DRAFT)
  viewport    Json?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flow       Flow            @relation(fields: [flowId], references: [id], onDelete: Cascade)
  nodes      FlowNode[]
  edges      FlowEdge[]
  executions FlowExecution[]

  @@unique([flowId, version])
  @@index([tenantId, status])
}

model FlowNode {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  versionId String       @db.Uuid
  aiAgentId String?      @db.Uuid
  key       String
  type      FlowNodeType
  label     String
  positionX Int
  positionY Int
  config    Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version  FlowVersion         @relation(fields: [versionId], references: [id], onDelete: Cascade)
  aiAgent  AiAgent?            @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)
  outgoing FlowEdge[]          @relation("FlowSourceNode")
  incoming FlowEdge[]          @relation("FlowTargetNode")
  steps    FlowExecutionStep[]

  @@unique([versionId, key])
  @@index([tenantId, versionId, type])
}

model FlowEdge {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  versionId    String   @db.Uuid
  sourceNodeId String   @db.Uuid
  targetNodeId String   @db.Uuid
  label        String?
  condition    Json?
  createdAt    DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version    FlowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sourceNode FlowNode    @relation("FlowSourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode FlowNode    @relation("FlowTargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([tenantId, versionId])
}

model FlowExecution {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @db.Uuid
  flowId         String              @db.Uuid
  versionId      String              @db.Uuid
  conversationId String?             @db.Uuid
  status         FlowExecutionStatus @default(RUNNING)
  input          Json?
  output         Json?
  errorMessage   String?
  startedAt      DateTime            @default(now())
  finishedAt     DateTime?

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flow         Flow                @relation(fields: [flowId], references: [id], onDelete: Cascade)
  version      FlowVersion         @relation(fields: [versionId], references: [id], onDelete: Cascade)
  conversation Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  steps        FlowExecutionStep[]

  @@index([tenantId, status, startedAt])
  @@index([tenantId, conversationId])
}

model FlowExecutionStep {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  executionId  String              @db.Uuid
  nodeId       String?             @db.Uuid
  status       FlowExecutionStatus @default(RUNNING)
  input        Json?
  output       Json?
  errorMessage String?
  startedAt    DateTime            @default(now())
  finishedAt   DateTime?

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  execution FlowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  node      FlowNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([tenantId, executionId, startedAt])
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  ownerMemberId  String?        @db.Uuid
  name           String
  document       String?
  email          String?
  phone          String?
  status         CustomerStatus @default(PROSPECT)
  ispAccountCode String?
  planName       String?
  address        Json?
  metadata       Json?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerMember        TenantMember?       @relation("CustomerOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  contacts           CustomerContact[]
  sentMessages       Message[]           @relation("CustomerMessages")
  conversations      Conversation[]
  activities         ContactActivity[]
  contracts          Contract[]
  invoices           Invoice[]
  leads              Lead[]
  deals              Deal[]
  campaignRecipients CampaignRecipient[]
  scheduleEvents     ScheduleEvent[]
  tasks              Task[]

  @@unique([tenantId, document])
  @@unique([tenantId, ispAccountCode])
  @@index([tenantId, status])
  @@index([tenantId, phone])
  @@index([tenantId, deletedAt])
  @@index([tenantId, deletedAt, ispAccountCode])
  @@index([tenantId, deletedAt, updatedAt])
}

model Contract {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid
  customerId   String         @db.Uuid
  externalId   String
  status       ContractStatus @default(UNKNOWN)
  planName     String?
  serviceLogin String?
  address      Json?
  metadata     Json?
  deletedAt    DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@unique([tenantId, externalId])
  @@index([tenantId, customerId])
  @@index([tenantId, customerId, deletedAt])
  @@index([tenantId, status])
  @@index([tenantId, status, deletedAt])
  @@index([tenantId, deletedAt])
}

model Invoice {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  customerId  String        @db.Uuid
  contractId  String?       @db.Uuid
  externalId  String
  status      InvoiceStatus @default(UNKNOWN)
  amountCents Int?
  dueDate     DateTime?
  paidAt      DateTime?
  metadata    Json?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@unique([tenantId, externalId])
  @@index([tenantId, customerId])
  @@index([tenantId, customerId, deletedAt])
  @@index([tenantId, contractId])
  @@index([tenantId, status])
  @@index([tenantId, status, deletedAt])
  @@index([tenantId, dueDate])
  @@index([tenantId, deletedAt])
}

model CustomerContact {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  customerId String   @db.Uuid
  name       String
  email      String?
  phone      String?
  role       String?
  isPrimary  Boolean  @default(false)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaignRecipients CampaignRecipient[]

  @@index([tenantId, customerId])
  @@index([tenantId, phone])
}

model ContactActivity {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  customerId     String?  @db.Uuid
  leadId         String?  @db.Uuid
  conversationId String?  @db.Uuid
  type           String
  title          String
  description    String?
  metadata       Json?
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId, occurredAt])
  @@index([tenantId, leadId, occurredAt])
}

model Lead {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @db.Uuid
  customerId    String?    @db.Uuid
  ownerMemberId String?    @db.Uuid
  name          String
  email         String?
  phone         String?
  source        String?
  status        LeadStatus @default(NEW)
  score         Int?
  metadata      Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  convertedAt   DateTime?

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  ownerMember        TenantMember?       @relation("LeadOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  activities         ContactActivity[]
  deals              Deal[]
  campaignRecipients CampaignRecipient[]
  scheduleEvents     ScheduleEvent[]
  tasks              Task[]

  @@index([tenantId, status])
  @@index([tenantId, phone])
}

model Pipeline {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  deals  Deal[]

  @@unique([tenantId, name])
}

model PipelineStage {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  pipelineId String   @db.Uuid
  name       String
  position   Int
  color      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, position])
  @@unique([pipelineId, name])
  @@index([tenantId])
}

model Deal {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @db.Uuid
  pipelineId      String     @db.Uuid
  stageId         String     @db.Uuid
  customerId      String?    @db.Uuid
  leadId          String?    @db.Uuid
  ownerMemberId   String?    @db.Uuid
  title           String
  valueCents      Int
  currency        String     @default("BRL")
  status          DealStatus @default(OPEN)
  expectedCloseAt DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  metadata        Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline    Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage       PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  ownerMember TenantMember? @relation("DealOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, stageId])
}

model Campaign {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  integrationId   String?        @db.Uuid
  name            String
  description     String?
  status          CampaignStatus @default(DRAFT)
  messageTemplate String
  segmentRules    Json?
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration Integration?        @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  recipients  CampaignRecipient[]
  events      CampaignEvent[]

  @@index([tenantId, status, scheduledAt])
}

model CampaignRecipient {
  id             String                  @id @default(uuid()) @db.Uuid
  tenantId       String                  @db.Uuid
  campaignId     String                  @db.Uuid
  customerId     String?                 @db.Uuid
  contactId      String?                 @db.Uuid
  leadId         String?                 @db.Uuid
  channelAddress String
  status         CampaignRecipientStatus @default(PENDING)
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  failedAt       DateTime?
  convertedAt    DateTime?
  errorMessage   String?
  metadata       Json?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact  CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead     Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  events   CampaignEvent[]

  @@index([tenantId, campaignId, status])
  @@index([tenantId, channelAddress])
}

model CampaignEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  campaignId  String   @db.Uuid
  recipientId String?  @db.Uuid
  type        String
  payload     Json?
  occurredAt  DateTime @default(now())

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign  Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient CampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([tenantId, campaignId, occurredAt])
}

model ScheduleEvent {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  assignedMemberId String?             @db.Uuid
  customerId       String?             @db.Uuid
  leadId           String?             @db.Uuid
  conversationId   String?             @db.Uuid
  title            String
  description      String?
  location         String?
  startsAt         DateTime
  endsAt           DateTime
  status           ScheduleEventStatus @default(SCHEDULED)
  metadata         Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedMember TenantMember? @relation("EventAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, startsAt])
  @@index([tenantId, assignedMemberId, startsAt])
}

model Task {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @db.Uuid
  assignedMemberId String?    @db.Uuid
  customerId       String?    @db.Uuid
  leadId           String?    @db.Uuid
  conversationId   String?    @db.Uuid
  title            String
  description      String?
  status           TaskStatus @default(OPEN)
  dueAt            DateTime?
  completedAt      DateTime?
  metadata         Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedMember TenantMember? @relation("TaskAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, dueAt])
  @@index([tenantId, assignedMemberId])
}

model DashboardMetric {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  key         String
  granularity MetricGranularity
  value       Decimal           @db.Decimal(18, 4)
  dimensions  Json?
  bucketStart DateTime
  bucketEnd   DateTime
  createdAt   DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, granularity, bucketStart])
  @@index([tenantId, bucketStart])
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @db.Uuid
  memberId  String             @db.Uuid
  title     String
  body      String?
  status    NotificationStatus @default(UNREAD)
  metadata  Json?
  createdAt DateTime           @default(now())
  readAt    DateTime?

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member TenantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, memberId, status])
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  actorMemberId String?  @db.Uuid
  action        String
  entityType    String
  entityId      String?
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorMember TenantMember? @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
}
