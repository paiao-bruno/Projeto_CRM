# ---------------------------------------------------------------------------
# Site único Vértice (Next.js + PostgreSQL). Nenhum servidor adicional é necessário.
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# Banco de dados da aplicação
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=isp_crm
DATABASE_URL=postgresql://crm:crm@localhost:5432/isp_crm?schema=public

# Autenticação (mínimo 32 caracteres; em desenvolvimento um segredo local é gerado se ausente)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars

# Cifra de segredos de conexões de canal (base64 de 32 bytes). Obrigatória em produção.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# APP_ENCRYPTION_KEY=

# Bootstrap de produção (scripts/bootstrap-production.mjs)
# BOOTSTRAP_TENANT_NAME=
# BOOTSTRAP_TENANT_SLUG=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Módulos de demonstração (desabilitados por padrão)
NEXT_PUBLIC_ENABLE_CAMPAIGNS=false
NEXT_PUBLIC_ENABLE_FLOWS=false
NEXT_PUBLIC_ENABLE_SCHEDULE=false
NEXT_PUBLIC_ENABLE_TEAM_CHAT=false

# Simulador de entrada da Caixa de entrada (padrão: ligado fora de produção)
# VERTICE_DEMO_INBOUND=true

# ---------------------------------------------------------------------------
# Testes de integração (banco DESCARTÁVEL; nunca aponte para o banco da aplicação).
# Usuário com CREATEDB, host local, banco de manutenção (postgres/template1), porta diferente de 5432.
# TEST_DATABASE_ADMIN_URL=postgresql://usuario:senha@localhost:5433/postgres
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# LEGADO (apps/api, NestJS) - fora do fluxo padrão. Só é usado com
# LEGACY_API_ENABLED=true (npm run dev:legacy-api). O agendador SGP exige ainda
# SGP_LEGACY_SYNC_ENABLED=true. Registros importados anteriormente permanecem no banco.
# ---------------------------------------------------------------------------
# LEGACY_API_ENABLED=false
# SGP_LEGACY_SYNC_ENABLED=false
# PORT=4000
# ENCRYPTION_KEY=change-me-use-at-least-32-characters-here
