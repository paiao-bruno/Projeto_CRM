# Application
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
PORT=4000
AUTO_SEED_DEMO=true

# Database
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=isp_crm
DATABASE_URL=postgresql://crm:crm@localhost:5432/isp_crm?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
PASSWORD_PEPPER=change-me-password-pepper

# Encryption for integration credentials
ENCRYPTION_KEY=change-me-32-byte-key

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# WhatsApp provider
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=

# SGP integration
SGP_API_URL=
SGP_APP=
SGP_TOKEN=
SGP_TIMEOUT_MS=15000
SGP_CUSTOMERS_ENDPOINT=/api/v2/integra/clientes/
