# Application
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
PORT=4000
AUTO_SEED_DEMO=false

# SGP real homologation (scripts/homologate-sgp-real.mjs)
# SGP_API_URL=https://sua-instancia.sgp.net.br
# SGP_APP=
# SGP_TOKEN=

# Database
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=isp_crm
DATABASE_URL=postgresql://crm:crm@localhost:5432/isp_crm?schema=public
SHADOW_DATABASE_URL=postgresql://crm:crm@localhost:5432/isp_crm_shadow?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars

# Encryption for integration credentials (required, min 32 chars)
ENCRYPTION_KEY=change-me-use-at-least-32-characters-here

# Security
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
SECURITY_SANITIZE_REQUESTS=true
SECURITY_SQL_INJECTION_GUARD=true
REQUEST_BODY_LIMIT=1mb

# Production only
# SGP_DEBUG_ENABLED=false

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# WhatsApp provider
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=

# SGP automatic sync scheduler
SGP_AUTO_SYNC_ENABLED=true
SGP_AUTO_SYNC_CRON=0 */6 * * *
SGP_AUTO_SYNC_INTERVAL_MINUTES=360
SGP_AUTO_SYNC_RETRY_ATTEMPTS=3
SGP_AUTO_SYNC_RETRY_DELAY_MS=60000
SGP_AUTO_SYNC_TIMEOUT_MS=900000
